# Public site URL (used for canonical, sitemap, robots, Open Graph)
NEXT_PUBLIC_SITE_URL=https://faizal-jewellery-badagara.vercel.app

# Cloudinary cloud name — used by the browser for building image delivery URLs.
# Keep this in sync with CLOUDINARY_CLOUD_NAME below.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=sqsrrir4

# ── Server-only secrets (set in Vercel → Project → Settings → Environment Variables) ──
# These NEVER ship to the browser. Required for the /admin panel (signed uploads,
# server-side deletes, and the JSON manifest "database" on Cloudinary).
CLOUDINARY_CLOUD_NAME=sqsrrir4
CLOUDINARY_API_KEY=426545761577182
# Do NOT commit the real secret. Paste it into the Vercel env var below.
CLOUDINARY_API_SECRET=

# Admin panel password (login at /admin/login).
ADMIN_PASSWORD=123456

# Secret used to sign the admin session cookie (use a long random string).
SESSION_SECRET=change-me-to-a-long-random-string
